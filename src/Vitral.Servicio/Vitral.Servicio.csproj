<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>VitralSensores</AssemblyName>
    <RootNamespace>Vitral.Servicio</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <ApplicationIcon>..\Vitral.App\vitral.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vitral.Core\Vitral.Core.csproj" />
    <ProjectReference Include="..\Vitral.Sensores\Vitral.Sensores.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
  </ItemGroup>

</Project>
